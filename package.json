{
  "name": "pi-deep-plan",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous planning loop for Pi: self-interview, self-research, single-shot plan review, then gated execution. Hard write protection during planning phases.",
  "keywords": [
    "pi-package",
    "pi",
    "plan",
    "planning",
    "extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YsLtr/pi-deep-plan.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "typebox": "*"
  },
  "dependencies": {
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
